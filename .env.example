# Application
APP_NAME=BizIntel AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# Set when PostgreSQL is provisioned. The analytics role must be read-only.
DATABASE_URL=postgresql+psycopg://bizintel_app:change-me@localhost:5432/bizintel
ANALYTICS_DATABASE_URL=postgresql+psycopg://bizintel_analytics:change-me@localhost:5432/bizintel

# Model providers are optional; never expose these values to the browser.
OLLAMA_BASE_URL=http://localhost:11434
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=

